{
  "input": {
    "shape": [1, 3, 640, 640],
    "layout": "NHWC for RKNN tools, NCHW for ONNX Runtime",
    "value_range": "float [0,1] before quantization",
    "pass_through": 1
  },
  "models": [
    {
      "name": "FP16",
      "file": "models/rknn/yolo11s_640_split.rknn",
      "input_dtype": "float16",
      "input_layout": "NHWC",
      "outputs": "[1,4,8400] + [1,80,8400]"
    },
    {
      "name": "INT8",
      "file": "models/rknn/yolo11s_640_split_int8.rknn",
      "input_dtype": "int8",
      "input_layout": "NHWC",
      "quantization": "scale=0.00392157, zero_point=-128",
      "outputs": "[1,4,8400] + [1,80,8400]"
    }
  ],
  "target": {
    "board": "Orange Pi (RKNN target)",
    "runtime": "librknnrt.so",
    "benchmark_video": "assets/regression/input.mp4",
    "benchmark_frames": 300
  }
}
